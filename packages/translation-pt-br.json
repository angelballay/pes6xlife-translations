{
  "recipe": "pes6pkg-recipe/1",
  "package": "translation-pt-br",
  "name": "Português (Brasil)",
  "release": {
    "repo": "angelballay/pes6xlife-translations",
    "tag": "pt-br-v{version}",
    "archive": "PES6_Translation_pt-br_v{version}.zip"
  },
  "requires": [
    {
      "package": "hdtext",
      "min": "1.0.2"
    },
    {
      "package": "translations",
      "min": "1.0"
    }
  ],
  "bundles": [
    "translations"
  ],
  "files": [
    {
      "path": "dat/pt-br_text.afs",
      "install": true,
      "from": "tools/pes6tr.py build (merge de languages/pt-br/pt-br.json con la plantilla de e_text.afs; --source <dat>/e_text.afs --install afs)"
    },
    {
      "path": "Docs/translation-pt-br/README.txt",
      "install": false,
      "from": "packages/zip/translation/README.txt"
    },
    {
      "path": "Docs/translation-pt-br/LEEME.txt",
      "install": false,
      "from": "packages/zip/translation/LEEME.txt"
    }
  ]
}
