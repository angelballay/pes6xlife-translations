{
  "recipe": "pes6pkg-recipe/1",
  "package": "translation-ru",
  "name": "Русский",
  "release": {
    "repo": "angelballay/pes6xlife-translations",
    "tag": "ru-v{version}",
    "archive": "PES6_Translation_ru_v{version}.zip"
  },
  "requires": [
    {
      "package": "hdtext",
      "min": "1.0.2"
    },
    {
      "package": "translations",
      "min": "1.0"
    }
  ],
  "files": [
    {
      "path": "dat/ru_text.afs",
      "install": true,
      "from": "tools/pes6tr.py build (merge de languages/ru/ru.json con la plantilla de e_text.afs; --source <dat>/e_text.afs --install afs)"
    },
    {
      "path": "README.txt",
      "install": false,
      "from": "packages/zip/translation/README.txt"
    },
    {
      "path": "LEEME.txt",
      "install": false,
      "from": "packages/zip/translation/LEEME.txt"
    }
  ]
}
