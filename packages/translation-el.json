{
  "recipe": "pes6pkg-recipe/1",
  "package": "translation-el",
  "name": "Ελληνικά",
  "release": {
    "repo": "angelballay/pes6xlife-translations",
    "tag": "el-v{version}",
    "archive": "PES6_Translation_el_v{version}.zip"
  },
  "requires": [
    {
      "package": "hdtext",
      "min": "1.0.2"
    },
    {
      "package": "translations",
      "min": "1.0"
    }
  ],
  "bundles": [
    "translations"
  ],
  "files": [
    {
      "path": "dat/el_text.afs",
      "install": true,
      "from": "tools/pes6tr.py build (merge de languages/el/el.json con la plantilla de e_text.afs; --source <dat>/e_text.afs --install afs)"
    },
    {
      "path": "Docs/translation-el/README.txt",
      "install": false,
      "from": "packages/zip/translation/README.txt"
    },
    {
      "path": "Docs/translation-el/LEEME.txt",
      "install": false,
      "from": "packages/zip/translation/LEEME.txt"
    }
  ]
}
